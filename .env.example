# Application Port (3000 for Docker container, 5001 for local backend development)
APP_PORT=3000
PORT=5001

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=states_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Connection URL (for local backend development)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/states_db
